---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TextDiscography from "../../components/TextDiscography.astro";
import { loadWorks } from "../../lib/works";

const items = await loadWorks();
---

<BaseLayout
  title="Discography (Text) | Andres Algaba — Mix Engineer"
  description="Text version of the discography for search engines and assistants."
>
  <main class="page">
    <div class="container">
      <h1>Discography (Text)</h1>
      <p class="muted">
        This page complements the interactive grid on the homepage with a crawlable list of credits.
      </p>
      <TextDiscography items={items} />
    </div>
  </main>
</BaseLayout>

<style>
  .page {
    padding: clamp(2rem, 6vw, 4rem) 0;
    background: #000;
    min-height: 100vh;
    min-height: 100svh;
  }

  h1 {
    margin: 0 0 0.75rem 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    color: #e7e7e7;
  }
</style>

