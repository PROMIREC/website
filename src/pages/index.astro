---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ArtistLibrary from "../components/ArtistLibrary.astro";
import { loadWorks } from "../lib/works";

const sectionMenuLinks = [
  { label: "Bio", href: "#bio" },
  { label: "Discography", href: "#discography" },
  { label: "Contact", href: "#contact" },
];
const getSectionMenuLinks = (currentId: string) =>
  sectionMenuLinks.filter((link) => link.href !== `#${currentId}`);

const works = await loadWorks();
const mixedOrMastered = works.filter(work => /\b(?:mix|master)(?:ed|ing)?\b/i.test(work.role ?? ""));
const catalogStreams = works.reduce((sum, work) => sum + (work.streams ?? 0), 0);
const plays = new Intl.NumberFormat("en-US", {
  notation: "compact",
  compactDisplay: "long",
  maximumFractionDigits: 2,
}).format(catalogStreams);
const currentYear = new Intl.DateTimeFormat("en", { year: "numeric", timeZone: "Europe/Brussels" }).format(new Date());
---

<BaseLayout
  title="Andres Algaba — Mixing & Mastering Engineer | PROMIREC"
  description="Mixing and mastering engineer with credits across international releases. Discography, audio previews, and contact."
>
  <Hero
    name="Andres Algaba"
    title="Mix Engineer"
    buttons={[
      { label: "Bio", href: "#bio" },
      { label: "Discography", href: "#discography" },
      { label: "Contact", href: "#contact" },
    ]}
  />

  <main>
    <section id="bio" class="section">
      <div class="container">
        <div class="section__header">
          <h2>Bio</h2>
          <details class="section-menu">
            <summary class="section-menu__button" aria-label="Open section menu">
              <span class="section-menu__icon" aria-hidden="true"></span>
            </summary>
            <nav class="section-menu__panel" aria-label="Section">
              <ul class="section-menu__list">
                {getSectionMenuLinks("bio").map((link) => (
                  <li>
                    <a class="section-menu__link" href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        </div>
        <p>
          Graduated from Berklee College Of Music in 2012 with a degree in Music Production and
          Engineering. After college I moved to Los Angeles where I got the chance to work at The
          House of Rock under the guidance of Jack Joseph Puig and later on at the legendary Henson
          Recording Studios in Hollywood, CA as a runner/assistant-trainee.
        </p>
        <p>
          In 2014, I returned to my roots in Belgium and embarked on a freelance career as a
          recording &amp; mixing engineer. Over the years, I've carved out a niche for myself,
          primarily as a mix engineer.
        </p>
        <p>
          I've been incredibly fortunate to collaborate with international sensations like Lost
          Frequencies, K3, Fedde Le Grand, Henri PFR, Kris Kross Amsterdam, Jaap Reesema, Flemming,
          Snelle, Compact Disk Dummies, Regi, M.I.K.E Push, OT, Aeroplane, Yves Paquet, Lea Rue,
          Maurice West, Two Pauz, Solarrio, Stereoclip, Metejoor, Natalia, Bart Peeters, Bart Kaëll,
          Jan Leyers Laura Tesoro, HIDDN, Chackie Jam, Astodan... and many more.
        </p>
        <p>
          As of <span id="bio-year">{currentYear}</span>, I've worked on {works.length.toLocaleString("en-US")} songs, including {mixedOrMastered.length.toLocaleString("en-US")} that I mixed or mastered.
          The full catalog has reached {plays} plays across digital streaming platforms. 33 of those singles and 3 albums have been honored
          with 27 GOLD, 108 PLATINUM and 2 DIAMOND awards. Notably, Lost Frequencies' "Alive &amp;
          Feeling Fine" and Metejoor's self-titled debut album both clinched Album of the Year awards
          at the Belgian Music Industry Awards.
        </p>
      </div>
    </section>

    <section id="discography" class="section">
      <div class="container">
        <div class="section__header">
          <h2>Discography</h2>
          <details class="section-menu section-menu--sticky">
            <summary class="section-menu__button" aria-label="Open section menu">
              <span class="section-menu__icon" aria-hidden="true"></span>
            </summary>
            <nav class="section-menu__panel" aria-label="Section">
              <ul class="section-menu__list">
                {getSectionMenuLinks("discography").map((link) => (
                  <li>
                    <a class="section-menu__link" href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        </div>
        <ArtistLibrary items={works} />
        <p><a class="text-discography-link" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/discography/`}>Text discography</a></p>
      </div>
    </section>

    <section id="contact" class="section section--contact">
      <div class="container">
        <div class="section__header">
          <h2>Contact</h2>
          <details class="section-menu">
            <summary class="section-menu__button" aria-label="Open section menu">
              <span class="section-menu__icon" aria-hidden="true"></span>
            </summary>
            <nav class="section-menu__panel" aria-label="Section">
              <ul class="section-menu__list">
                {getSectionMenuLinks("contact").map((link) => (
                  <li>
                    <a class="section-menu__link" href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        </div>
        <p class="muted">Send a message and I'll get back to you soon.</p>

        <form
          id="contact-form"
          class="contact"
          method="post"
          action="https://formspree.io/f/xvzzzzgd"
        >
          <label>
            <span>Name</span>
            <input name="name" autocomplete="name" />
          </label>

          <label>
            <span>Email</span>
            <input name="email" type="email" autocomplete="email" />
          </label>

          <label>
            <span>Message</span>
            <textarea name="message" rows="5"></textarea>
          </label>

          <button type="submit">Send</button>
        </form>

        <p class="contact__success" role="status" aria-live="polite" hidden>
          Thanks for the message. I'll get back to you soon.
        </p>
        <p class="contact__error" role="status" aria-live="polite" hidden>
          Something went wrong. Please try again.
        </p>
      </div>
    </section>
  </main>

  <script type="module">
    document.getElementById("bio-year").textContent = new Intl.DateTimeFormat("en", {
      year: "numeric", timeZone: "Europe/Brussels",
    }).format(new Date());

    const form = document.querySelector("#contact-form");
    if (form) {
      const container = form.closest("#contact");
      const success = container?.querySelector(".contact__success");
      const error = container?.querySelector(".contact__error");
      const submitButton = form.querySelector('button[type="submit"]');

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (success) success.hidden = true;
        if (error) error.hidden = true;
        if (submitButton) submitButton.disabled = true;
        form.setAttribute("aria-busy", "true");

        try {
          const response = await fetch(form.action, {
            method: form.method,
            body: new FormData(form),
            headers: {
              Accept: "application/json",
            },
          });

          if (response.ok) {
            form.reset();
            if (success) success.hidden = false;
          } else if (error) {
            error.hidden = false;
          }
        } catch (err) {
          if (error) error.hidden = false;
        } finally {
          if (submitButton) submitButton.disabled = false;
          form.removeAttribute("aria-busy");
        }
      });
    }

    const sectionMenus = Array.from(document.querySelectorAll(".section-menu"));
    if (sectionMenus.length) {
      const closeMenus = (exception) => {
        sectionMenus.forEach((menu) => {
          if (menu !== exception) {
            menu.removeAttribute("open");
          }
        });
      };

      document.addEventListener("click", (event) => {
        const target = event.target;
        const menu = target instanceof Element ? target.closest(".section-menu") : null;
        closeMenus(menu ?? undefined);
      });

      window.addEventListener(
        "scroll",
        () => {
          closeMenus();
        },
        { passive: true },
      );
    }
  </script>
</BaseLayout>

<style>
  .text-discography-link { color: #000; }
  .text-discography-link:hover,
  .text-discography-link:focus-visible { color: #ccc; }
</style>
