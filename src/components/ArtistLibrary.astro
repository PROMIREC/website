---
import type { WorkItem } from "../lib/works";

import releaseTitles from "../data/release-titles.json";
const titlesByCover: Record<string, string> = releaseTitles;

function groupReleases(tracks: WorkItem[]) {
  const named = new Map<string, WorkItem[]>();
  const other: WorkItem[] = [];
  for (const track of tracks) {
    const title = track.albumName || titlesByCover[track.artworkUrl ?? ""];
    if (!title) {
      other.push(track);
      continue;
    }
    const group = named.get(title);
    if (group) group.push(track);
    else named.set(title, [track]);
  }
  const albums = [...named].map(([title, songs]) => ({
    title, songs, streams: songs.reduce((sum, song) => sum + (song.streams ?? 0), 0),
  })).sort((a, b) => b.streams - a.streams || a.title.localeCompare(b.title));
  if (other.length) albums.push({ title: albums.length ? "Other tracks" : "", songs: other, streams: 0 });
  return albums;
}

const { items } = Astro.props as { items: WorkItem[] };
const byArtist = new Map<string, { artist: string; tracks: WorkItem[] }>();
for (const track of items) {
  const artist = track.artist.split(",")[0].trim();
  const key = artist.normalize("NFC").toLowerCase();
  const group = byArtist.get(key);
  if (group) group.tracks.push(track);
  else byArtist.set(key, { artist, tracks: [track] });
}
const artists = [...byArtist.values()].map(({ artist, tracks }) => ({
  artist,
  tracks,
  covers: [...new Set([...tracks]
    .sort((a, b) => (b.streams ?? 0) - (a.streams ?? 0))
    .map(track => track.artworkUrl)
    .filter(Boolean))].slice(0, 3),
  streams: tracks.reduce((sum, track) => sum + (track.streams ?? 0), 0),
})).sort((a, b) => b.streams - a.streams || a.artist.localeCompare(b.artist, "en", { sensitivity: "base" }));
const libraryStreams = artists.reduce((sum, artist) => sum + artist.streams, 0);
const streamNumber = new Intl.NumberFormat("en-US");
const sleeves = [...byArtist.values()].map(({ tracks }) => tracks[0].artworkUrl).filter(Boolean).slice(0, 3);
---
<div class="discography-wall">
  <details class="library">
    <summary class="library-heading">
      <span class="sleeves" aria-hidden="true">
        {sleeves.map((src, i) => <img src={src} alt="" loading="lazy" style={`--i:${i}`} />)}
      </span>
      <span><strong>Artist library</strong><small>{artists.length} artists · {items.length} tracks · {streamNumber.format(libraryStreams)} streams</small></span>
      <i class="chevron" aria-hidden="true"></i>
    </summary>
    <div class="catalog">
      <div class="library-controls">
        <input type="search" aria-label="Find an artist" placeholder="Find an artist…" />
        <label>Sort by
          <select>
            <option value="streams">Most streamed</option>
            <option value="artist">Alphabetical</option>
            <option value="count">Track count</option>
          </select>
        </label>
      </div>
      <p class="empty" role="status" hidden>No matching artists.</p>
      <div class="artist-list">
        {artists.map(({artist, tracks, streams, covers}) => (
          <details class="artist" name="discography-artist" data-artist={artist} data-count={tracks.length} data-streams={streams}>
            <summary>
              <span class="artist-sleeves" aria-hidden="true">
                {covers.map((src, i) => <img src={src} alt="" width="64" height="64" loading="lazy" decoding="async" style={`--layer:${i}`} />)}
              </span>
              <span class="artist-name">{artist}</span>
              <small>{tracks.length} {tracks.length === 1 ? "track" : "tracks"} · {streamNumber.format(streams)}&nbsp;streams</small>
              <i class="chevron" aria-hidden="true"></i>
            </summary>
            {groupReleases(tracks).map(({ title, songs }) => (
              <div class="release">
                {title && <h4>{title} <small>{songs.length} {songs.length === 1 ? "track" : "tracks"}</small></h4>}
                <div class="tracks">
                  {songs.map(track => (
                    <button class="track" type="button" data-track={JSON.stringify(track)} aria-haspopup="dialog">
                      <img src={track.artworkUrl} alt="" loading="lazy" width="48" height="48" />
                      <span><strong>{track.title}</strong><small>{track.artist}</small></span>
                    </button>
                  ))}
                </div>
              </div>
            ))}
          </details>
        ))}
      </div>
      <p class="muted">Streaming totals across platforms provided by Muso.ai.</p>
    </div>
  </details>
  <div class="discography-modal" data-open="false" aria-hidden="true">
    <div class="discography-modal__backdrop" data-action="close"></div>
    <div
      class="discography-modal__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="discography-modal-title"
      tabindex="-1"
    >
      <button class="discography-modal__close" type="button" aria-label="Close dialog">
        X
      </button>
      <div class="discography-modal__content">
        <div class="discography-modal__art">
          <img class="discography-modal__image" alt="" />
        </div>
        <div class="discography-modal__panel">
          <div class="discography-modal__heading">
            <p class="discography-modal__artist"></p>
            <span class="discography-modal__divider" aria-hidden="true">-</span>
            <h3 id="discography-modal-title" class="discography-modal__title"></h3>
          </div>
          <p class="discography-modal__streams"></p>
          <p class="discography-modal__credit"></p>
          <div class="discography-modal__audio">
            <a
              class="discography-modal__spotify"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Open on Spotify"
              hidden
            >
              Spotify
            </a>
            <button class="discography-modal__toggle" type="button" aria-label="Play preview">
              Play
            </button>
            <audio class="discography-modal__player" controls tabindex="-1"></audio>
            <p class="discography-modal__note" hidden>Click play to start</p>
          </div>
          <p class="discography-modal__label"></p>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="module">
  (() => {
    const root = document.querySelector(".discography-wall");
    const catalog = root.querySelector(".catalog");
    const rows = Array.from(catalog.querySelectorAll(".artist"));
    const artistList = catalog.querySelector(".artist-list");
    const sort = catalog.querySelector("select");
    const names = new Intl.Collator("en", { sensitivity: "base" });
    sort.addEventListener("change", () => {
      const key = sort.value;
      rows.sort((a, b) => {
        const difference = key === "artist" ? 0 : Number(b.dataset[key]) - Number(a.dataset[key]);
        return difference || names.compare(a.dataset.artist, b.dataset.artist);
      });
      artistList.append(...rows);
    });
    const search = catalog.querySelector("input");
    search.addEventListener("input", () => {
      const query = search.value.trim().toLocaleLowerCase();
      for (const row of rows) row.hidden = !row.dataset.artist.toLocaleLowerCase().includes(query);
      catalog.querySelector(".empty").hidden = rows.some(row => !row.hidden);
    });
    const modal = root.querySelector(".discography-modal");
    const dialog = root.querySelector(".discography-modal__dialog");
    const closeButton = root.querySelector(".discography-modal__close");
    const backdrop = root.querySelector(".discography-modal__backdrop");
    const modalImage = root.querySelector(".discography-modal__image");
    const modalArtist = root.querySelector(".discography-modal__artist");
    const modalTitle = root.querySelector(".discography-modal__title");
    const modalLabel = root.querySelector(".discography-modal__label");
    const modalStreams = root.querySelector(".discography-modal__streams");
    const modalCredit = root.querySelector(".discography-modal__credit");
    const modalSpotify = root.querySelector(".discography-modal__spotify");
    const modalToggle = root.querySelector(".discography-modal__toggle");
    const modalPlayer = root.querySelector(".discography-modal__player");
    const modalNote = root.querySelector(".discography-modal__note");

    const focusableSelector =
      'a[href], button:not([disabled]), input, textarea, select, details, [tabindex]:not([tabindex="-1"])';

    let lastFocused = null;
    let fadeRaf = null;
    let sessionId = 0;

    const prefersReducedMotion =
      window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const setToggleState = (isPlaying) => {
      if (isPlaying) {
        modalToggle.textContent = "Stop";
        modalToggle.setAttribute("aria-label", "Stop preview");
      } else {
        modalToggle.textContent = "Play";
        modalToggle.setAttribute("aria-label", "Play preview");
      }
    };

    const formatStreams = (value) => {
      const numberValue = Number(value);
      if (!Number.isFinite(numberValue)) return "";
      return new Intl.NumberFormat("en-US").format(numberValue);
    };

    const deriveCreditLine = (role = "") => {
      const normalized = String(role).toLowerCase();
      const hasMix = normalized.includes("mix");
      const hasMaster = normalized.includes("master");
      if (hasMix && hasMaster) return "Mixed & mastered by yours truly";
      if (hasMaster) return "Mastered by yours truly";
      if (hasMix) return "Mixed by yours truly";
      return role ? `${role} credit by Andres Algaba` : "Credit by Andres Algaba";
    };

    const fadeAudio = (audio, targetVolume, durationMs, onComplete) => {
      if (!audio) return;
      if (fadeRaf) {
        cancelAnimationFrame(fadeRaf);
        fadeRaf = null;
      }
      if (prefersReducedMotion || durationMs === 0) {
        audio.volume = targetVolume;
        if (typeof onComplete === "function") {
          onComplete();
        }
        return;
      }
      const startVolume = audio.volume;
      const startTime = performance.now();
      const step = (now) => {
        const progress = Math.min(1, (now - startTime) / durationMs);
        audio.volume = startVolume + (targetVolume - startVolume) * progress;
        if (progress < 1) {
          fadeRaf = requestAnimationFrame(step);
        } else {
          fadeRaf = null;
          if (typeof onComplete === "function") {
            onComplete();
          }
        }
      };
      fadeRaf = requestAnimationFrame(step);
    };

    const playPreview = (session) => {
      modalNote.hidden = true;
      modalPlayer.volume = prefersReducedMotion ? 1 : 0;
      const playPromise = modalPlayer.play();
      if (playPromise && typeof playPromise.catch === "function") {
        playPromise
          .then(() => {
            if (session !== sessionId || modal.dataset.open !== "true") {
              return;
            }
            setToggleState(true);
            fadeAudio(modalPlayer, 1, 1500);
          })
          .catch(() => {
            if (session !== sessionId || modal.dataset.open !== "true") {
              return;
            }
            setToggleState(false);
            modalNote.hidden = false;
          });
      } else {
        if (session !== sessionId || modal.dataset.open !== "true") {
          return;
        }
        setToggleState(true);
        fadeAudio(modalPlayer, 1, 1500);
      }
    };

    const pausePreview = () => {
      if (modalPlayer.paused) {
        setToggleState(false);
        return;
      }
      fadeAudio(modalPlayer, 0, 1500, () => {
        modalPlayer.pause();
        setToggleState(false);
      });
    };

    const stopAudioImmediate = () => {
      if (fadeRaf) {
        cancelAnimationFrame(fadeRaf);
        fadeRaf = null;
      }
      modalPlayer.pause();
      try {
        modalPlayer.currentTime = 0;
      } catch (error) {
        // Ignore reset errors on unloaded media.
      }
      modalPlayer.volume = 1;
      setToggleState(false);
    };

    const getFocusableElements = () =>
      Array.from(dialog.querySelectorAll(focusableSelector)).filter(
        (el) => !el.hasAttribute("disabled") && el.getAttribute("tabindex") !== "-1"
      );

    const trapFocus = (event) => {
      if (modal.dataset.open !== "true" || event.key !== "Tab") return;
      const focusables = getFocusableElements();
      if (!focusables.length) return;

      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const active = document.activeElement;

      if (event.shiftKey && active === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    };

    const openModal = (item) => {
      if (!item) return;
      lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;

      modalImage.src = item.artworkUrl;
      modalImage.alt = `${item.title} by ${item.artist}`;
      modalArtist.textContent = item.artist;
      modalTitle.textContent = item.title;
      if (item.label) {
        modalLabel.textContent = `Label: ${item.label}`;
        modalLabel.hidden = false;
      } else {
        modalLabel.textContent = "";
        modalLabel.hidden = true;
      }
      modalStreams.textContent = `${formatStreams(item.streams)} streams`;
      modalCredit.textContent = deriveCreditLine(item.role);
      const spotifyUrl = item.spotifyUrl;
      if (spotifyUrl) {
        modalSpotify.href = spotifyUrl;
        modalSpotify.hidden = false;
      } else {
        modalSpotify.href = "#";
        modalSpotify.hidden = true;
      }
      modalNote.hidden = true;

      modalPlayer.pause();
      modalPlayer.src = item.previewUrl;
      modalPlayer.load();
      modalPlayer.volume = prefersReducedMotion ? 1 : 0;
      setToggleState(false);
      sessionId += 1;
      const session = sessionId;

      modal.dataset.open = "true";
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";

      requestAnimationFrame(() => {
        closeButton.focus();
        playPreview(session);
      });
    };

    const closeModal = () => {
      if (modal.dataset.open !== "true") return;
      modal.dataset.open = "false";
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      sessionId += 1;
      stopAudioImmediate();
      modalPlayer.removeAttribute("src");
      modalPlayer.load();
      modalNote.hidden = true;

      if (lastFocused) {
        lastFocused.focus();
      }
    };

    catalog.addEventListener("click", (event) => {
      const button = event.target.closest(".track");
      if (button) openModal(JSON.parse(button.dataset.track));
    });

    closeButton.addEventListener("click", closeModal);
    backdrop.addEventListener("click", closeModal);
    modalSpotify.addEventListener("click", () => {
      stopAudioImmediate();
    });
    modalToggle.addEventListener("click", () => {
      if (modalPlayer.paused || modalPlayer.ended) {
        playPreview(sessionId);
      } else {
        stopAudioImmediate();
      }
    });
    modalPlayer.addEventListener("play", () => {
      setToggleState(true);
    });
    modalPlayer.addEventListener("pause", () => {
      if (modal.dataset.open === "true") {
        setToggleState(false);
      }
    });
    modalPlayer.addEventListener("ended", () => {
      setToggleState(false);
    });
    modal.addEventListener("keydown", trapFocus);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeModal();
      }
    });

  })();
</script>

<style>
  summary { display: flex; align-items: center; gap: clamp(.75rem, 3vw, 2rem); cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .library-heading { padding: 1.8rem .5rem; }
  .library-heading strong { display: block; font-size: clamp(1.5rem, 4vw, 3rem); font-weight: 400; line-height: 1.2; letter-spacing: -.035em; color: #eee; }
  small { display: block; color: #aaa; font-size: .82rem; font-variant-numeric: tabular-nums; }
  .sleeves { position: relative; width: clamp(68px, 12vw, 118px); flex: none; aspect-ratio: 1.45; }
  .sleeves img { position: absolute; inset: 3% auto auto 5%; height: 90%; aspect-ratio: 1; background: #282828; border: 1px solid #666; transform: translateX(calc(var(--i) * 15%)) rotate(calc((var(--i) - 1) * 6deg)); transition: transform 320ms cubic-bezier(.2,.8,.2,1); }
  .library[open] .sleeves img, .library-heading:hover img { transform: translateX(calc(var(--i) * 23%)) rotate(calc((var(--i) - 1) * 13deg)); }
  .chevron { margin-left: auto; margin-right: .5rem; width: .65rem; height: .65rem; flex: none; border: solid currentColor; border-width: 0 1.5px 1.5px 0; transform: rotate(45deg); transition: transform 220ms ease; }
  details[open] > summary > .chevron { transform: rotate(225deg); }
  .catalog { padding: 0 .5rem 1rem; }
  .library-controls { display: flex; flex-wrap: wrap; align-items: center; gap: .65rem 1rem; margin-bottom: 2rem; }
  .library-controls input { flex: 1 1 15rem; min-width: 0; }
  .library-controls label { display: flex; align-items: center; gap: .6rem; }
  .library-controls :is(input, select) { color-scheme: dark; padding: .85rem 1rem; background: #181818; color: #eee; border: 1px solid #555; border-radius: 3px; font: inherit; }
  .artist { border-top: 1px solid #383838; }
  .artist summary { min-height: 5.75rem; padding: .85rem .6rem; }
  .artist-sleeves { --size: clamp(44px, 5vw, 64px); position: relative; flex: none; width: calc(var(--size) * 1.6); height: var(--size); isolation: isolate; }
  .artist-sleeves img { position: absolute; left: 4%; top: 0; width: var(--size); height: var(--size); object-fit: cover; background: #262626; border: 1px solid #545454; box-shadow: 1px 3px 5px #0009; z-index: calc(3 - var(--layer)); transform: translateX(calc(12% * var(--layer))) rotate(calc(var(--layer) * 4deg)); transition: transform 320ms cubic-bezier(.2,.8,.2,1); }
  .artist[open] .artist-sleeves img, .artist summary:is(:hover, :focus-visible) .artist-sleeves img { transform: translateX(calc(24% * var(--layer))) rotate(calc(var(--layer) * 9deg - 4deg)); }
  .artist-name { flex: 1; font-size: clamp(1.15rem, 2.4vw, 1.65rem); color: #dedede; overflow-wrap: anywhere; }
  .artist summary:hover, .artist[open] > summary { background: #141414; }
  .artist .chevron { margin-left: 0; }
  .release h4 { display: flex; align-items: baseline; gap: .75rem; flex-wrap: wrap; margin: 0; padding: 1rem .6rem .5rem; color: #eee; font-size: 1.12rem; font-weight: 500; }
  .release h4 small { font-weight: 400; }
  .tracks { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,19rem),1fr)); gap: 2px; padding-block: .3rem 1rem; }
  .track { display: flex; align-items: center; gap: .85rem; min-width: 0; padding: .7rem; background: #161616; color: #eee; text-align: left; font: inherit; cursor: pointer; border: 0; }
  .track:hover { background: #292929; }
  .track img { flex: none; background: #252525; }
  .track strong { font-weight: 500; }
  .track span { overflow-wrap: anywhere; }
  :is(summary, input, select, .track):focus-visible { outline: 2px solid #eee; outline-offset: -2px; }
  @media (max-width: 640px) {
    .artist summary { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 0 .6rem; }
    .artist-sleeves { grid-column: 1; grid-row: 1 / 3; }
    .artist summary small { grid-column: 2; }
    .artist summary .chevron { grid-column: 3; grid-row: 1 / 3; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .artist { interpolate-size: allow-keywords; }
    .artist::details-content { block-size: 0; overflow: clip; transition: block-size 280ms ease, content-visibility 280ms allow-discrete; }
    .artist[open]::details-content { block-size: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sleeves img, .artist-sleeves img, .chevron { transition: none; }
  }
</style>
