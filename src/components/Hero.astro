---
const { name, title, buttons = [] } = Astro.props;
const baseUrl = import.meta.env.BASE_URL || "/";
const normalizedBaseUrl = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const portraitImageUrl = encodeURI(`${normalizedBaseUrl}img/portrait.png`);
const fullTitle = `${name} | ${title}`;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner">
    <div class="hero__content">
      <h1 id="hero-title" class="hero__title">{fullTitle}</h1>

      {buttons.length > 0 && (
        <nav class="hero__nav" aria-label="Primary">
          <ul class="hero__nav-list">
            {buttons.map((button) => (
              <li class="hero__nav-item">
                <a class="hero__link" href={button.href}>
                  {button.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>

    <div class="hero__media" aria-hidden="true">
      <picture class="hero__picture">
        <source media="(max-width: 720px)" srcset={portraitImageUrl} />
        <img
          class="hero__portrait"
          src={portraitImageUrl}
          alt=""
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #000;
  }

  .hero__inner {
    width: min(1600px, 100%);
    margin: 0 auto;
    padding: clamp(2.5rem, 8vw, 6rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(2rem, 8vw, 6rem);
  }

  .hero__content {
    width: min(32rem, 100%);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    z-index: 1;
  }

  .hero__media {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: clamp(700px, 65vw, 1200px);
    opacity: 0;
    transform: translateY(6px);
    animation: hero-fade 5000ms ease forwards;
    animation-delay: 230ms;
  }

  .hero__portrait {
    width: 100%;
    height: auto;
    max-height: 92vh;
    object-fit: contain;
    object-position: right center;
    display: block;
    transform: none;
  }

  .hero__title {
    margin: 0;
    font-size: clamp(1.4rem, 2.6vw, 2.4rem);
    font-weight: 300;
    letter-spacing: 0.05em;
    color: #cfcfcf;
    white-space: nowrap;
  }

  .hero__nav {
    margin-top: 1.5rem;
    width: 100%;
  }

  .hero__nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    justify-content: center;
  }

  .hero__link {
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    color: #a6a6a6;
    text-decoration: none;
    text-underline-offset: 0.35em;
  }

  .hero__link:hover,
  .hero__link:focus-visible {
    color: #e0e0e0;
    text-decoration: underline;
  }

  .hero__title,
  .hero__nav {
    opacity: 0;
    transform: translateY(6px);
    animation: hero-fade 650ms ease forwards;
  }

  .hero__title {
    animation-delay: 150ms;
  }

  .hero__nav {
    animation-delay: 320ms;
  }

  @keyframes hero-fade {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 520px) {
    .hero__title {
      letter-spacing: 0.02em;
      white-space: normal;
    }
  }

  @media (max-width: 720px) {
    .hero__inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .hero__content {
      align-items: center;
    }

    .hero__media {
      order: -1;
      width: 100%;
      justify-content: center;
    }

    .hero__portrait {
      width: min(88vw, 620px);
      transform: scale(1);
    }

    .hero__picture::after {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media,
    .hero__title,
    .hero__nav {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
