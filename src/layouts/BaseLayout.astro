---
import "../styles/global.css";

const {
  title = "Andres Algaba — Mixing & Mastering Engineer | PROMIREC",
  description = "Mixing and mastering engineer with credits across international releases. Discography, audio previews, and contact.",
  image = "/img/og.jpg",
  imageAlt = "Portrait of Andres Algaba",
  imageWidth = 1200,
  imageHeight = 630,
  ogType = "website",
  extraJsonLd,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://promirec.com");
const pageUrl = new URL(Astro.url.pathname, siteUrl);
const ogImageUrl = new URL(image, siteUrl);
const personImageUrl = new URL("/img/portrait.png", siteUrl);

const sameAs = [
  "https://www.instagram.com/promirec",
  "https://www.facebook.com/promirec",
  "https://open.spotify.com/playlist/5WvWL0ZUvgjdfthCLzFMS8?si=613a621caa314770",
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Andres Algaba",
  alternateName: ["PROMIREC"],
  url: new URL("/", siteUrl).href,
  image: personImageUrl.href,
  jobTitle: "Mixing and mastering engineer",
  description,
  homeLocation: {
    "@type": "Place",
    name: "Antwerpen, Belgium",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Antwerpen",
      addressCountry: "BE",
    },
  },
  knowsAbout: ["Mixing", "Mastering", "Audio engineering", "Music production"],
  sameAs,
};

const extraJsonLdArray = Array.isArray(extraJsonLd)
  ? extraJsonLd
  : extraJsonLd
    ? [extraJsonLd]
    : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Andres Algaba" />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="theme-color" content="#000000" />

	    <link rel="canonical" href={pageUrl.href} />
	    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

	    <meta property="og:type" content={ogType} />
	    <meta property="og:site_name" content="PROMIREC" />
	    <meta property="og:title" content={title} />
	    <meta property="og:description" content={description} />
	    <meta property="og:url" content={pageUrl.href} />
	    <meta property="og:image" content={ogImageUrl.href} />
	    <meta property="og:image:alt" content={imageAlt} />
	    {typeof imageWidth === "number" && typeof imageHeight === "number" && (
	      <>
	        <meta property="og:image:width" content={String(imageWidth)} />
	        <meta property="og:image:height" content={String(imageHeight)} />
	      </>
	    )}

    <meta name="twitter:card" content="summary_large_image" />
	    <meta name="twitter:title" content={title} />
	    <meta name="twitter:description" content={description} />
	    <meta name="twitter:image" content={ogImageUrl.href} />

    {sameAs.map((href) => (
      <link rel="me" href={href} />
    ))}

	    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	    {extraJsonLdArray.map((data) => (
	      <script type="application/ld+json" set:html={JSON.stringify(data)} />
	    ))}
	  </head>
  <body>
    <slot />
    <footer class="site-footer">
      <div class="container site-footer__row">
        <span class="site-footer__cell site-footer__cell--left">PROMIREC BV</span>
        <span class="site-footer__cell site-footer__cell--center">BE 1002.585.664</span>
        <span class="site-footer__cell site-footer__cell--right">
          Uitbreidingstraat 538, 2600 Antwerpen
        </span>
      </div>
    </footer>
  </body>
</html>
